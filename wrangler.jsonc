// Cloudflare Workers (Workers Builds): `npm run build` then `npx wrangler deploy` serves web/out
// as static assets, and runs worker/src/index.ts for /api/* only. `name` must match the
// Worker's name in the Cloudflare dashboard. See README.md, "Accounts".
{
  "name": "news-feed",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every other request is served from web/out without running the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-feed",
      // Replace with the id that `wrangler d1 create news-feed` prints.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    // The Firebase project whose ID tokens the API accepts. Not a secret.
    "FIREBASE_PROJECT_ID": ""
  }
}
