# Secrets. YT_API_KEY lives here; never commit it. See .env.example.
.env
.env.local

# Installed by the news-feed skill on first run (package-lock.json is committed).
node_modules/

# The root package.json only holds shortcut scripts and has no dependencies; a stray
# `npm install` here would write a lockfile that makes Next.js warn about multiple lockfiles.
/package-lock.json

# macOS
.DS_Store
._*

# Claude Code local overrides
.claude/settings.local.json

# Your sources and digests (source.json, data/). Keep them out of this repo, or make
# content/ a git repo of its own; see README.md.
/content/
