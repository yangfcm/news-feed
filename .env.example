# Copy to .env and fill in. .env is gitignored.
# YouTube Data API v3 key, used by the news-feed skill for YouTube sources.
# Create one at https://console.cloud.google.com/apis/credentials
# Without it, podcast and blog sources still work; only YouTube sources fail.
YT_API_KEY=

# Two-letter ISO 3166-1 country code you watch from (e.g. AU, US, CN). YouTube videos
# whose region restriction does not allow this country are left out of the digest.
# Without it, region-restricted videos are not filtered.
COUNTRY=
