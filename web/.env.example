# The Firebase web app's config, for the account pages. Copy to .env.local, which is gitignored,
# and fill in from the Firebase console (Project settings > Your apps). These values are public:
# they identify the project and grant nothing. On a host, set them as build environment
# variables instead. Leave them out and the site builds without accounts.
# See README.md (in the project root), "Accounts".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only: where `npm run dev:api` serves the API, since `npm run dev` runs on
# another port. Leave unset for a build: the site and the API then share an origin.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:8787

# Local development only: the Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
