{
  "name": "news-feed-worker",
  "private": true,
  "type": "module",
  "description": "The Cloudflare Worker behind /api/*: checks Firebase sign-ins and keeps the users table in D1.",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config ../wrangler.jsonc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261119.0-beta",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
